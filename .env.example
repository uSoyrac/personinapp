# ──────────────────────────────────────────────────────────────
# PracticeForge environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — NEVER commit real keys.
# ──────────────────────────────────────────────────────────────

# Public site URL (used for SEO canonical/OG + Stripe redirect URLs).
# Local: http://localhost:3000  ·  Prod: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ────────────────────────────────────────────────────
# From Stripe dashboard → Developers → API keys
STRIPE_SECRET_KEY=
# Optional (only if doing client-side Stripe.js). Server redirect flow doesn't need it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From Stripe dashboard → Developers → Webhooks (after you create the endpoint)
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs per plan & billing cycle (Stripe → Products → Add price).
# STRIPE_PRICE_PRO / STRIPE_PRICE_ELITE are the monthly fallback; the _QUARTERLY
# and _ANNUAL ids back the 3-month and annual (1-month-free) toggle options.
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_QUARTERLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ELITE=
STRIPE_PRICE_ELITE_QUARTERLY=
STRIPE_PRICE_ELITE_ANNUAL=

# ── AI (optional) ─────────────────────────────────────────────
# If unset, practice generation falls back to deterministic mock data.
OPENAI_API_KEY=
